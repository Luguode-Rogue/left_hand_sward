<?xml version="1.0" encoding="utf-8"?>
<base type="solution">
  <!-- Native animation XML is loaded from project.mbproj, not SubModule.xml <Xmls>.
       Keep the standard soln_* ids and module-root-relative ModuleData paths. -->
  <file id="soln_action_sets" name="ModuleData/action_sets.xml" type="action_set" />
  <file id="soln_action_types" name="ModuleData/action_types.xml" type="action_type" />
</base>
